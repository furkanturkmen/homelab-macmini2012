# Home: ~/homelab/wg-relay/wg_confs/wg0.conf  (gitignored; docs/10-public-relay.md)
# Generate the key without installing anything on the host:
#   umask 077; mkdir -p wg-relay/wg_confs
#   docker run --rm --entrypoint wg lscr.io/linuxserver/wireguard genkey > wg-relay/home.key
#   docker run --rm -i --entrypoint wg lscr.io/linuxserver/wireguard pubkey < wg-relay/home.key
[Interface]
PrivateKey = <contents of wg-relay/home.key>
Address = 10.77.0.2/32
# The relay may reach only what listens inside this container (the forwarders
# on 80 and 443). Nothing is routed onward into the LAN.
PostUp = iptables -I FORWARD -i %i -j DROP
PostDown = iptables -D FORWARD -i %i -j DROP

[Peer]
PublicKey = <contents of /etc/wireguard/relay.pub on the VPS>
Endpoint = 203.0.113.10:51820
AllowedIPs = 10.77.0.0/24
# Home sits behind NAT; the keepalive holds the path open so the VPS can
# reach it at any time without a port forward on the router.
PersistentKeepalive = 25
