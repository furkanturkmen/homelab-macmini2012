# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env
#   nano .env
#   docker compose up -d

# LAN IP of the host running Docker (used by Pi-hole port binding + Nextcloud trusted domain).
# Find yours with `ip -4 addr show | grep inet`.
HOST_LAN_IP=192.168.1.10

# Timezone used by every container. See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# User + group ID owned files on the host will be mapped to inside the *arr containers.
# On Linux run `id -u` and `id -g` — usually 1000 for the first user.
PUID=1000
PGID=1000

# Pi-hole admin web UI password.
PIHOLE_PASSWORD=changeme

# MariaDB root password (used by Nextcloud DB container).
MARIADB_ROOT_PASSWORD=changeme-root

# MariaDB password for the `nextcloud` user (referenced by both nextcloud-db AND nextcloud).
MARIADB_PASSWORD=changeme-nextcloud

# Host group IDs for Jellyfin GPU (VA-API) access.
# Find yours with `getent group render video` — the render GID differs per machine.
VIDEO_GID=44
RENDER_GID=991

# ntfy push notifications.
# NTFY_TOPIC doubles as a shared secret - anyone who knows it can read your
# notifications, so generate a random one rather than picking a name:
#   head -c 12 /dev/urandom | base64 | tr -dc 'a-z0-9' | head -c 16
NTFY_TOPIC=changeme-random-topic
NTFY_USER=homelab
NTFY_PASSWORD=changeme

# Shared secret the Jellylab app presents when registering its push token.
# Generate: head -c 18 /dev/urandom | base64 | tr -d '/+=' | head -c 24
PUSH_REGISTER_SECRET=changeme

# Address clients reach ntfy on. Use the VPN address if you subscribe from a
# phone away from home, so links inside notifications resolve there too.
NTFY_BASE_URL=http://10.0.0.1:8095

# ProtonVPN WireGuard key for the gluetun tunnel qBittorrent runs inside.
# Generate at Proton account > Downloads > WireGuard, with NAT-PMP (Port
# Forwarding) turned ON and a P2P-capable server, then copy the PrivateKey line.
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=10.2.0.2/32
# From the [Peer] section of the same Proton .conf
WIREGUARD_PUBLIC_KEY=changeme
VPN_ENDPOINT_IP=1.2.3.4
VPN_ENDPOINT_PORT=51820
